{
	"name": "vscode-asciidoc-presentation",
	"displayName": "AsciiDoc Presentation",
	"description": "Create presentation slides with AsciiDoc and Reveal.js",
	"version": "2.2.0",
	"publisher": "bzzzil",
	"repository": "https://github.com/bzzzil/vscode-asciidoc-presentation.git",
	"license": "MIT",
	"pricing": "Free",
	"engines": {
		"vscode": "^1.105.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onCommand:asciidocSlides.preview",
		"onCommand:asciidocSlides.exportHtml",
		"onCommand:asciidocSlides.exportInlinedHtml",
		"onCommand:asciidocSlides.openInBrowser",
		"onLanguage:asciidoc"
	],
	"icon": "media/favicon.png",
	"keywords": [
		"asciidoc",
		"reveal.js",
		"slides",
		"presentation"
	],
	"main": "./dist/extension.js",
	"extensionDependencies": [
		"asciidoctor.asciidoctor-vscode"
	],
	"contributes": {
		"commands": [
			{
				"command": "asciiDocPresentation.preview",
				"title": "Show Presentation Preview Beside",
				"category": "AsciiDoc Presentation"
			},
			{
				"command": "asciiDocPresentation.openInBrowser",
				"title": "Open Presentation in Browser",
				"category": "AsciiDoc Presentation"
			},
			{
				"command": "asciiDocPresentation.exportHtml",
				"title": "Export presentation to HTML file",
				"category": "AsciiDoc Presentation"
			},
			{
				"command": "asciiDocPresentation.exportInlinedHtml",
				"title": "Export presentation to inlined HTML file",
				"category": "AsciiDoc Presentation"
			}
		]
	},
	"scripts": {
		"precompile": "npm run build:libs-highlight && npm run build:libs-reveal",
		"compile": "webpack --mode development",
		"prewatch": "npm run precompile",
		"watch": "webpack --watch --mode development",
		"package": "webpack --mode production --devtool hidden-source-map",
		"compile-tests": "tsc -p . --outDir out",
		"watch-tests": "tsc -p . -w --outDir out",
		"pretest": "npm run compile-tests && npm run compile && npm run lint",
		"lint": "eslint src",
		"test": "vscode-test",
		"build:libs-highlight": "node scripts/build-highlight-bundle.js",
		"build:libs-reveal": "node scripts/build-reveal-bundle.js"
	},
	"devDependencies": {
		"@types/ejs": "^3.1.5",
		"@types/express": "^5.0.6",
		"@types/mocha": "^10.0.7",
		"@types/node": "^25.0.2",
		"@types/serve-favicon": "^2.5.7",
		"@types/vscode": "^1.107.0",
		"@types/web-resource-inliner": "^4.2.5",
		"@typescript-eslint/eslint-plugin": "^8.50.0",
		"@typescript-eslint/parser": "^8.49.0",
		"@vscode/test-cli": "^0.0.12",
		"@vscode/test-electron": "^2.5.2",
		"eslint": "^9.39.2",
		"glob": "^13.0.0",
		"mocha": "^11.7.5",
		"ts-loader": "^9.5.1",
		"typescript": "^5.9.3",
		"webpack": "^5.104.1",
		"webpack-cli": "^6.0.1"
	},
	"dependencies": {
		"@asciidoctor/reveal.js": "5.0.1",
		"@highlightjs/cdn-assets": "^11.11.1",
		"@types/ws": "^8.5.12",
		"asciidoctor": "^3.0.4",
		"asciidoctor-kroki": "^0.18.1",
		"axios": "^1.13.2",
		"bufferutil": "^4.1.0",
		"ejs": "^3.1.10",
		"express": "^5.2.1",
		"highlight.js": "^11.10.0",
		"open": "^11.0.0",
		"reveal.js": "^5.1.0",
		"reveal.js-plugins": "^4.2.5",
		"serve-favicon": "^2.5.1",
		"slash": "^5.1.0",
		"utf-8-validate": "^6.0.4",
		"web-resource-inliner": "^8.0.0",
		"ws": "^8.18.0"
	},
	"author": "flobilosaurus"
}
