<script type="text/javascript" src="<%= absolutePath %>libs/qrcode/qrcode.min.js"></script>
<script type="text/javascript" src="<%= absolutePath %>libs/qrcode/index.js"></script>
<script type="text/javascript" src="<%= absolutePath %>libs/highlight.js/highlight.min.js"></script>
<script type="text/javascript" src="<%= absolutePath %>libs/reveal.js/plugin/math/math.js"></script>
<script type="text/javascript" src="<%= absolutePath %>libs/reveal.js-plugins/loadcontent/plugin.js"></script>
<script type="text/javascript" src="<%= absolutePath %>libs/reveal.js-plugins/animate/svg.min.js"></script>
<script type="text/javascript" src="<%= absolutePath %>libs/reveal.js-plugins/animate/plugin.js"></script>

<% if (!isInlined) { %>
<script>
    Reveal.initialize({
        hash: true,
        history: true,
        pdfMaxPagesPerSlide: 1,
        center: 'true' === '<%= center %>',
        controls: 'true' === '<%= controls %>',
        controlsLayout: '<%= controlsLayout %>',
        controlsBackArrows: '<%= controlsBackArrows %>',
        progress: 'true' === '<%= progress %>',
        transition: '<%= transition %>',
        transitionSpeed: '<%= transitionSpeed %>',
        backgroundTransition: '<%= backgroundTransition %>',
        showNotes: false,
        slideNumber: ['true', 'false'].includes('<%- slideNumber %>') ? '<%- slideNumber %>' === 'true' : '<%- slideNumber %>',
        animate: {
            autoplay: true // default is false
        },
        dependencies: [
            { src: '<%= absolutePath %>libs/reveal.js/plugin/notes/notes.js', async: true, callback: () => { Reveal.registerPlugin(RevealNotes)}  },
            { src: '<%= absolutePath %>libs/reveal.js/plugin/zoom/zoom.js', async: true, callback: () => { Reveal.registerPlugin(RevealZoom)} },
        ],
        plugins: [ Plugin.MathJax2, RevealLoadContent, RevealAnimate, RevealQRCode ]
    })
</script>
<% } else { %>
<script>
    Reveal.initialize({
        hash: true,
        history: true,
        center: 'true' === '<%= center %>',
        controls: 'true' === '<%= controls %>',
        controlsLayout: '<%= controlsLayout %>',
        controlsBackArrows: '<%= controlsBackArrows %>',
        progress: 'true' === '<%= progress %>',
        transition: '<%= transition %>',
        transitionSpeed: '<%= transitionSpeed %>',
        backgroundTransition: '<%= backgroundTransition %>',
        slideNumber: ['true', 'false'].includes('<%- slideNumber %>') ? '<%- slideNumber %>' === 'true' : '<%- slideNumber %>',
        dependencies: [],
        plugins: [ Plugin.MathJax2, RevealQRCode ]
    });
</script>
<% } %>
<script>
    hljs.highlightAll();
</script>
