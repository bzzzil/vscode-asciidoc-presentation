<script type="text/javascript" src="<%= absolutePath %>libs/reveal.js/plugin/math/math.js"></script>
<% if (!isInlined) { %>
<script>
    Reveal.initialize({
        hash: true,
        history: true,
        pdfMaxPagesPerSlide: 1,
        center: 'true' === '<%= center %>',
        controls: 'true' === '<%= controls %>',
        controlsLayout: '<%= controlsLayout %>',
        controlsBackArrows: '<%= controlsBackArrows %>',
        progress: 'true' === '<%= progress %>',
        transition: '<%= transition %>',
        transitionSpeed: '<%= transitionSpeed %>',
        backgroundTransition: '<%= backgroundTransition %>',
        slideNumber: ['true', 'false'].includes('<%- slideNumber %>') ? '<%- slideNumber %>' === 'true' : '<%- slideNumber %>',
        dependencies: [
            { src: '<%= absolutePath %>libs/reveal.js/plugin/notes/notes.js', async: true },
            { src: '<%= absolutePath %>libs/reveal.js/plugin/zoom/zoom.js', async: true },
            { src: '<%= absolutePath %>libs/reveal.js/plugin/highlight/highlight.js', async: true, callback: function() { hljs.highlightAll(); }},
            { src: '<%= absolutePath %>libs/reveal.js/plugin/qrcode/qrcode.min.js', async: true },
            { src: '<%= absolutePath %>libs/reveal.js/plugin/qrcode/index.js', async: true },
        ],
        plugins: [ Plugin.MathJax2 ]
    })
</script>
<% } %>

<% if (isInlined) { %>
<script type="text/javascript" src="<%= absolutePath %>libs/reveal.js/plugin/zoom/zoom.js"></script>
<script type="text/javascript" src="<%= absolutePath %>libs/reveal.js/plugin/highlight/highlight.js"></script>
<script type="text/javascript" src="<%= absolutePath %>libs/reveal.js/plugin/qrcode/qrcode.min.js"></script>
<script type="text/javascript" src="<%= absolutePath %>libs/reveal.js/plugin/qrcode/index.js"></script>
<script>
    Reveal.initialize({
        hash: true,
        history: true,
        center: 'true' === '<%= center %>',
        controls: 'true' === '<%= controls %>',
        controlsLayout: '<%= controlsLayout %>',
        controlsBackArrows: '<%= controlsBackArrows %>',
        progress: 'true' === '<%= progress %>',
        transition: '<%= transition %>',
        transitionSpeed: '<%= transitionSpeed %>',
        backgroundTransition: '<%= backgroundTransition %>',
        slideNumber: ['true', 'false'].includes('<%- slideNumber %>') ? '<%- slideNumber %>' === 'true' : '<%- slideNumber %>',
        dependencies: [],
        plugins: [ Plugin.MathJax2 ]
    });

    hljs.highlightAll();
</script>

<% } %>
