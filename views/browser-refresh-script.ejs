
<% if (isPreview) { %>
<script>
    const runningInIFrame = window !== window.parent
    // only create websocket connection in external browser,
    // when webpage is not running in iframe
    if(!runningInIFrame) {
        const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
        const websocketUrl = protocol + '//' + window.location.host + "<%= websocketPath %>?token=<%= websocketToken %>";
        let socket;
        const connect = function() {
            socket = new WebSocket(websocketUrl);
            socket.onmessage = function(event) {
                const data = JSON.parse(event.data)
                if(data.cmd === 'goto') {
                    location.href = '/#/' + data.slide
                    location.reload()
                } else if(data.cmd === 'syncSlide') {
                    const slideIndex = Reveal.getIndices();
                    if ( slideIndex.h != data.slide_h || slideIndex.v != data.slide_v || slideIndex.f != data.fragment) {
                        Reveal.slide(data.slide_h, data.slide_v, data.fragment);
                    }
                }
            };
            socket.onclose = function() {
                window.setTimeout(connect, 1000);
            };
            socket.onerror = function() {
                socket.close();
            };
        }

        connect();
        Reveal.addEventListener('slidechanged', function(event) {
            const slideIndex = Reveal.getIndices();
            if (socket.readyState === WebSocket.OPEN) {
                socket.send(JSON.stringify({
                    cmd: 'slideChanged',
                    slide_h: slideIndex.h,
                    slide_v: slideIndex.v,
                    fragment: slideIndex.f
                }));
            }
        });
    }
</script>
<% } %>